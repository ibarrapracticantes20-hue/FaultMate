# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - FaultMate
# ============================================================================
# Copia este archivo como ".env" (en la misma carpeta) para correr el
# proyecto en local. El script setup_local.bat lo hace automaticamente.
# ============================================================================

# Clave secreta de Django. Para desarrollo local cualquier valor sirve.
SECRET_KEY=django-insecure-desarrollo-local-cambia-este-valor

# True para desarrollo local. Debe ser False en produccion/Azure.
DEBUG=True

# Hosts permitidos, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1,*.local

# Origenes CSRF confiables (dejar vacio en local).
CSRF_TRUSTED_ORIGINS=

# BASE DE DATOS
# ----------------
# Vacio = usa SQLite automaticamente (db.sqlite3), ideal para desarrollo local.
# Para usar MySQL (ej. WAMP): mysql://usuario:password@127.0.0.1:3306/nombre_bd
# Para usar PostgreSQL: postgresql://usuario:password@localhost/nombre_bd
DATABASE_URL=

# Solo necesario si DATABASE_URL apunta a MySQL/Postgres SIN SSL (ej. WAMP local).
# Dejar sin definir (o True) en produccion/Azure.
# DB_SSL_REQUIRE=False

# GOOGLE GENAI (OPCIONAL)
# ========================
# GOOGLE_API_KEY=tu_clave_api_aqui
